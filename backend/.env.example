# =========================================================
# RUPUR backend settings – is file ki copy ".env" naam se banao
# .env kabhi GitHub pe ya kisi ko mat bhejna
# =========================================================

# development = apne computer pe, production = live
APP_ENV=production
APP_URL=https://www.rupurfragrances.com
PORT=8000

# ---- Database ----
# Live: mysql   |   Apne computer pe bina MySQL ke: sqlite (Node 22.13 ya naya chahiye)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ---- Razorpay (Dashboard > Account & Settings > API Keys) ----
# Testing ke liye rzp_test_... keys, live ke liye rzp_live_...
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks me URL: https://www.rupurfragrances.com/api/razorpay/webhook
# events: payment.captured, order.paid   (jo secret wahan rakho wahi yahan)
RAZORPAY_WEBHOOK_SECRET=

# ---- Delhivery ----
DELHIVERY_ENABLED=true
DELHIVERY_API_KEY=
# Live: https://track.delhivery.com   Testing: https://staging-express.delhivery.com
DELHIVERY_BASE_URL=https://track.delhivery.com
# Delhivery One me pickup location ka EXACT naam
DELHIVERY_PICKUP_LOCATION=Rupur Enterprises
DELHIVERY_SHIPPING_MODE=Surface
# Ek piece ka weight (grams, packing ke saath) jab product me alag se na likha ho
SHIP_WEIGHT_GRAMS=300

# ---- Email (Gmail) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=Rupurperfumes@gmail.com
# Gmail ka 16 letter wala App Password (normal password nahi chalega)
SMTP_PASS=
MAIL_FROM=Rupurperfumes@gmail.com
MAIL_FROM_NAME=RUPUR Fragrances
# Har naye order ki copy yahan aayegi
ORDER_NOTIFY_EMAIL=Rupurperfumes@gmail.com

# ---- Business ----
SELLER_NAME=Rupur Enterprises
SELLER_ADDRESS=In front of Tehsil, Kalapipal Mandi, Dist. Shajapur (M.P.) 465337
SUPPORT_PHONE=9713620850

# ---- Shipping (₹) ----
FREE_SHIPPING_ABOVE=999
SHIPPING_ONE_PIECE=80
SHIPPING_MULTI_PIECE=100
